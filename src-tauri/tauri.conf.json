{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArshVideoDownloader",
  "version": "0.1.0",
  "identifier": "com.arshdelight.arshvideodownloader",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArshVideoDownloader",
        "width": 720,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#f1f5f9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "binaries/yt-dlp.exe",
      "binaries/ffmpeg.exe",
      "binaries/parsehub-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Arshdelight/arsh-video-downloader/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1NTMxMTZCRDkzNTkwRUQKUldUdGtEWFpheEZUSlNqMk4zcEVPbVBFYjF6NEozK1YxTnJza0dTbnBJY3h3dEY0SmdQUlJoUnAK"
    }
  }
}
